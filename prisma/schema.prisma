generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum Marketplace {
  SHOPEE
  MERCADO_LIVRE
}

enum MarketplaceAccountStatus {
  DISCONNECTED
  CONNECTED
  REAUTH_REQUIRED
  ERROR
}

enum MercadoLivreAffiliateSessionStatus {
  NOT_CONFIGURED
  VALIDATING
  CONNECTED
  EXPIRED
  ERROR
}

enum AffiliateEligibility {
  ELIGIBLE
  INELIGIBLE
  UNKNOWN
}

enum TrackingStrategy {
  INTERNAL_REDIRECT
  DIRECT_AFFILIATE_LINK
}

enum OfferStatus {
  PENDING_VALIDATION
  REJECTED_INVALID_DATA
  REJECTED_EXPIRED
  REJECTED_DUPLICATE
  REJECTED_LOW_SCORE
  QUARANTINED_INTEGRATION_ERROR
  READY_FOR_AFFILIATE_LINK
  READY_TO_PUBLISH
  SCHEDULED
  PUBLISHED
  PUBLICATION_FAILED
}

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
  UNKNOWN
}

enum ShippingStatus {
  FREE
  NOT_FREE
  UNKNOWN
}

enum ChannelType {
  WHATSAPP_CLOUD
  WHATSAPP_CLOUD_API
  WHATSAPP_GROUPS
  WHATSAPP_GROUPS_API
  MANUAL_EXPORT
  TELEGRAM
}

enum PublicationStatus {
  SCHEDULED
  PUBLISHED
  EXPORTED
  PUBLICATION_FAILED
  FAILED
  CANCELLED
}

enum MessageSource {
  AI_GENERATED
  DETERMINISTIC_FALLBACK
}

enum AiProviderName {
  OLLAMA
  OPENAI
  DETERMINISTIC
}

enum PublicationAttemptStatus {
  PENDING
  SUCCESS
  EXPORTED
  FAILED
}

enum ImportJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  SUCCEEDED_WITH_ERRORS
  FAILED
}

enum ImportJobItemStage {
  DISCOVERY
  RESOLUTION
  AFFILIATE_LINK
  INGESTION
}

enum ImportJobItemStatus {
  PENDING
  RUNNING
  SUCCEEDED
  PENDING_AFFILIATE_LINK
  INELIGIBLE
  FAILED
  SKIPPED
}

enum AutomationRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum AlertSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MarketplaceAccount {
  id                    String                   @id @default(cuid())
  marketplace           Marketplace
  name                  String
  encryptedCredentials  String                   @default("")
  externalUserId        String?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  expiresAt             DateTime?
  scopes                Json                     @default("[]")
  status                MarketplaceAccountStatus @default(DISCONNECTED)
  siteId                String?
  lastRefreshAt         DateTime?
  lastSyncAt            DateTime?
  lastErrorAt           DateTime?
  lastError             String?
  capabilities          Json                     @default("{}")
  enabled               Boolean                  @default(true)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  importJobs                   ImportJob[]
  automationRuns               AutomationRun[]
  mercadoLivreAffiliateSession MercadoLivreAffiliateSession?

  @@index([marketplace, enabled])
  @@index([marketplace, status])
}

model MercadoLivreAffiliateSession {
  id                   String                             @id @default(cuid())
  marketplaceAccountId String                             @unique
  marketplaceAccount   MarketplaceAccount                 @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)
  sampleAffiliateLink  String?
  affiliateTag         String?
  availableTags        Json?
  cookieEncrypted      String?                            @db.Text
  csrfTokenEncrypted   String?                            @db.Text
  status               MercadoLivreAffiliateSessionStatus @default(NOT_CONFIGURED)
  lastValidatedAt      DateTime?
  lastCookieUpdateAt   DateTime?
  lastErrorAt          DateTime?
  lastError            String?                            @db.Text
  createdAt            DateTime                           @default(now())
  updatedAt            DateTime                           @updatedAt
}

model Channel {
  id                        String      @id @default(cuid())
  name                      String
  type                      ChannelType
  encryptedCredentials      String?
  configuration             Json?
  capabilities              Json        @default("{}")
  timezone                  String      @default("America/Fortaleza")
  dailyLimit                Int         @default(10)
  dailyPublicationLimit     Int         @default(10)
  minIntervalMinutes        Int         @default(30)
  minimumIntervalMinutes    Int         @default(30)
  allowedHours              Json        @default("[]")
  allowedStartTime          String?
  allowedEndTime            String?
  allowedCategories         Json        @default("[]")
  allowedMarketplaces       Json        @default("[]")
  minScore                  Int         @default(70)
  minimumScore              Int         @default(70)
  minPrice                  Decimal?    @db.Decimal(12, 2)
  maxPrice                  Decimal?    @db.Decimal(12, 2)
  minDiscountPercentage     Decimal?    @db.Decimal(5, 2)
  minRepeatDays             Int         @default(7)
  productRepeatIntervalDays Int         @default(7)
  enabled                   Boolean     @default(true)
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  publications Publication[]

  @@index([type, enabled])
}

model Product {
  id                String      @id @default(cuid())
  marketplace       Marketplace
  externalProductId String
  title             String
  description       String?
  category          String?
  imageUrl          String?
  productUrl        String
  rating            Decimal?    @db.Decimal(3, 2)
  salesCount        Int?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  offers Offer[]

  @@unique([marketplace, externalProductId])
  @@index([marketplace, category])
}

model Offer {
  id                          String               @id @default(cuid())
  marketplace                 Marketplace
  externalProductId           String
  productId                   String?
  version                     Int                  @default(1)
  offerFingerprint            String
  title                       String
  description                 String?
  category                    String?
  imageUrl                    String?
  productUrl                  String
  affiliateUrl                String?
  affiliateLabel              String?
  affiliateEligibility        AffiliateEligibility @default(UNKNOWN)
  affiliateFailure            Json?
  sellerId                    String?
  officialStoreId             String?
  sourceCategoryId            String?
  bestSellerPosition          Int?
  sourceHighlightId           String?
  sourceHighlightType         String?
  resolutionStrategy          String?
  trackingStrategy            TrackingStrategy     @default(INTERNAL_REDIRECT)
  originalPrice               Decimal?             @db.Decimal(12, 2)
  currentPrice                Decimal              @db.Decimal(12, 2)
  discountPercentage          Decimal?             @db.Decimal(5, 2)
  couponCode                  String?
  couponExpiration            DateTime?
  commissionPercentage        Decimal?             @db.Decimal(5, 2)
  rating                      Decimal?             @db.Decimal(3, 2)
  salesCount                  Int?
  freeShipping                Boolean              @default(false)
  shippingStatus              ShippingStatus       @default(UNKNOWN)
  stockStatus                 StockStatus          @default(UNKNOWN)
  score                       Int?
  scoreCompletenessPercentage Decimal?             @db.Decimal(5, 2)
  minimumScoreApplied         Int                  @default(70)
  status                      OfferStatus          @default(PENDING_VALIDATION)
  statusReason                String?
  collectedAt                 DateTime
  verifiedAt                  DateTime?
  scheduledAt                 DateTime?
  publishedAt                 DateTime?
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt

  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  coupons        Coupon[]
  affiliateLinks AffiliateLink[]
  scores         OfferScore[]
  publications   Publication[]
  clicks         Click[]
  conversions    Conversion[]
  commissions    Commission[]
  importJobItems ImportJobItem[]

  @@unique([productId, version])
  @@unique([productId, offerFingerprint])
  @@index([status, score])
  @@index([marketplace, category])
  @@index([marketplace, externalProductId])
  @@index([marketplace, affiliateEligibility])
  @@index([marketplace, sourceCategoryId, bestSellerPosition])
  @@index([trackingStrategy])
  @@index([scheduledAt])
  @@index([publishedAt])
}

model MercadoLivreDiscoveryConfig {
  id                        String    @id @default(cuid())
  enabled                   Boolean   @default(false)
  siteId                    String    @default("MLB")
  categoryIds               Json      @default("[]")
  bestSellersEnabled        Boolean   @default(true)
  minimumPrice              Decimal?  @db.Decimal(12, 2)
  maximumPrice              Decimal?  @db.Decimal(12, 2)
  minimumDiscountPercentage Decimal?  @db.Decimal(5, 2)
  minimumScore              Int       @default(0)
  maxCandidatesPerCategory  Int       @default(20)
  refreshIntervalMinutes    Int       @default(360)
  lastRunAt                 DateTime?
  lastRunSummary            Json?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
}

model Coupon {
  id             String    @id @default(cuid())
  offerId        String
  code           String
  description    String?
  discountAmount Decimal?  @db.Decimal(12, 2)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([code, expiresAt])
}

model AffiliateLink {
  id          String      @id @default(cuid())
  offerId     String
  slug        String      @unique
  destination String
  marketplace Marketplace
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  offer  Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  clicks Click[]

  @@index([offerId])
  @@index([marketplace])
}

model OfferScore {
  id                      String   @id @default(cuid())
  offerId                 String
  total                   Int
  completenessPercentage  Decimal? @db.Decimal(5, 2)
  discountComponent       Int
  commissionComponent     Int
  ratingComponent         Int
  popularityComponent     Int
  freeShippingComponent   Int
  couponValidityComponent Int
  noveltyComponent        Int
  weights                 Json
  createdAt               DateTime @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, createdAt])
}

model Publication {
  id                          String            @id @default(cuid())
  offerId                     String
  channelId                   String
  status                      PublicationStatus @default(SCHEDULED)
  idempotencyKey              String            @unique
  scheduledAt                 DateTime
  publishedAt                 DateTime?
  externalId                  String?
  messagePayload              Json?
  messageSource               MessageSource     @default(DETERMINISTIC_FALLBACK)
  aiProvider                  AiProviderName    @default(DETERMINISTIC)
  aiModel                     String?
  aiGenerationDurationMs      Int?
  aiValidationPassed          Boolean?
  aiValidationReasons         Json?
  generatedAt                 DateTime?
  offerTitleSnapshot          String
  productExternalIdSnapshot   String
  marketplaceSnapshot         Marketplace
  categorySnapshot            String?
  originalPriceSnapshot       Decimal?          @db.Decimal(12, 2)
  currentPriceSnapshot        Decimal           @db.Decimal(12, 2)
  discountPercentageSnapshot  Decimal?          @db.Decimal(5, 2)
  couponCodeSnapshot          String?
  couponExpirationSnapshot    DateTime?
  freeShippingSnapshot        Boolean
  shippingStatusSnapshot      ShippingStatus    @default(UNKNOWN)
  affiliateUrlSnapshot        String?
  trackingUrlSnapshot         String
  offerVersionSnapshot        Int
  sourceCategoryIdSnapshot    String?
  bestSellerPositionSnapshot  Int?
  sourceHighlightIdSnapshot   String?
  sourceHighlightTypeSnapshot String?
  resolutionStrategySnapshot  String?
  errorMessage                String?
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  offer       Offer                @relation(fields: [offerId], references: [id], onDelete: Cascade)
  channel     Channel              @relation(fields: [channelId], references: [id], onDelete: Cascade)
  attempts    PublicationAttempt[]
  clicks      Click[]
  conversions Conversion[]
  commissions Commission[]

  @@index([channelId, scheduledAt])
  @@index([offerId, status])
}

model PublicationAttempt {
  id              String                   @id @default(cuid())
  publicationId   String
  attemptNumber   Int                      @default(1)
  status          PublicationAttemptStatus @default(PENDING)
  requestPayload  Json?
  responsePayload Json?
  errorMessage    String?
  attemptedAt     DateTime                 @default(now())

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@index([publicationId, attemptedAt])
}

model Click {
  id              String      @id @default(cuid())
  offerId         String
  affiliateLinkId String?
  publicationId   String?
  channelId       String?
  marketplace     Marketplace
  userAgent       String?
  referer         String?
  createdAt       DateTime    @default(now())

  offer         Offer          @relation(fields: [offerId], references: [id], onDelete: Cascade)
  affiliateLink AffiliateLink? @relation(fields: [affiliateLinkId], references: [id], onDelete: SetNull)
  publication   Publication?   @relation(fields: [publicationId], references: [id], onDelete: SetNull)

  @@index([offerId, createdAt])
  @@index([publicationId, createdAt])
  @@index([marketplace, createdAt])
}

model Conversion {
  id              String      @id @default(cuid())
  marketplace     Marketplace
  externalOrderId String?
  offerId         String?
  publicationId   String?
  amount          Decimal     @db.Decimal(12, 2)
  occurredAt      DateTime
  importedAt      DateTime    @default(now())
  rawPayload      Json?

  offer       Offer?       @relation(fields: [offerId], references: [id], onDelete: SetNull)
  publication Publication? @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  commissions Commission[]

  @@index([marketplace, occurredAt])
  @@index([externalOrderId])
}

model Commission {
  id            String      @id @default(cuid())
  marketplace   Marketplace
  offerId       String?
  publicationId String?
  conversionId  String?
  amount        Decimal     @db.Decimal(12, 2)
  percentage    Decimal?    @db.Decimal(5, 2)
  status        String
  occurredAt    DateTime
  importedAt    DateTime    @default(now())

  offer       Offer?       @relation(fields: [offerId], references: [id], onDelete: SetNull)
  publication Publication? @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  conversion  Conversion?  @relation(fields: [conversionId], references: [id], onDelete: SetNull)

  @@index([marketplace, occurredAt])
  @@index([status])
}

model ImportJob {
  id                        String          @id @default(cuid())
  marketplaceAccountId      String?
  marketplace               Marketplace
  categoryId                String?
  status                    ImportJobStatus @default(QUEUED)
  source                    String
  totalFound                Int             @default(0)
  totalResolved             Int             @default(0)
  totalLinksGenerated       Int             @default(0)
  totalReadyToPublish       Int             @default(0)
  totalPendingAffiliateLink Int             @default(0)
  totalIneligible           Int             @default(0)
  totalCreated              Int             @default(0)
  totalUpdated              Int             @default(0)
  totalFailed               Int             @default(0)
  startedAt                 DateTime?
  finishedAt                DateTime?
  errorMessage              String?         @db.Text
  summary                   Json?           @map("rawSummary")
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt

  marketplaceAccount MarketplaceAccount? @relation(fields: [marketplaceAccountId], references: [id], onDelete: SetNull)
  items              ImportJobItem[]

  @@index([marketplace, status])
  @@index([marketplace, createdAt])
  @@index([marketplace, categoryId, createdAt])
  @@index([marketplaceAccountId, createdAt])
}

model ImportJobItem {
  id             String              @id @default(cuid())
  importJobId    String
  sourceId       String?
  sourceType     String?
  position       Int?
  externalItemId String?
  offerId        String?
  stage          ImportJobItemStage
  status         ImportJobItemStatus @default(PENDING)
  attempts       Int                 @default(0)
  errorCode      String?
  errorMessage   String?             @db.Text
  metadata       Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  offer     Offer?    @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@index([importJobId])
  @@index([importJobId, status])
  @@index([importJobId, stage])
  @@index([offerId])
  @@index([externalItemId])
}

model AutomationRun {
  id                   String              @id @default(cuid())
  marketplaceAccountId String?
  name                 String
  status               AutomationRunStatus @default(RUNNING)
  idempotencyKey       String              @unique
  startedAt            DateTime            @default(now())
  finishedAt           DateTime?
  metrics              Json?
  errorMessage         String?

  marketplaceAccount MarketplaceAccount? @relation(fields: [marketplaceAccountId], references: [id], onDelete: SetNull)

  @@index([name, startedAt])
}

model SystemAlert {
  id           String        @id @default(cuid())
  severity     AlertSeverity
  source       String
  message      String
  metadata     Json?
  acknowledged Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([severity, acknowledged])
  @@index([source, createdAt])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
