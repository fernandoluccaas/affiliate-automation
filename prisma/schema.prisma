generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

enum Marketplace {
  SHOPEE
  MERCADO_LIVRE
}

enum OfferStatus {
  PENDING_VALIDATION
  REJECTED_INVALID_DATA
  REJECTED_EXPIRED
  REJECTED_DUPLICATE
  REJECTED_LOW_SCORE
  QUARANTINED_INTEGRATION_ERROR
  READY_TO_PUBLISH
  SCHEDULED
  PUBLISHED
  PUBLICATION_FAILED
}

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
  UNKNOWN
}

enum ChannelType {
  WHATSAPP_CLOUD
  WHATSAPP_GROUPS
  MANUAL_EXPORT
  TELEGRAM
}

enum PublicationStatus {
  SCHEDULED
  PUBLISHED
  FAILED
  CANCELLED
}

enum PublicationAttemptStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ImportJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum AutomationRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum AlertSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MarketplaceAccount {
  id                   String      @id @default(cuid())
  marketplace          Marketplace
  name                 String
  encryptedCredentials String
  capabilities         Json        @default("{}")
  enabled              Boolean     @default(true)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  importJobs     ImportJob[]
  automationRuns AutomationRun[]

  @@index([marketplace, enabled])
}

model Channel {
  id                    String      @id @default(cuid())
  name                  String
  type                  ChannelType
  encryptedCredentials  String?
  capabilities          Json        @default("{}")
  dailyLimit            Int         @default(10)
  minIntervalMinutes    Int         @default(30)
  allowedHours          Json        @default("[]")
  allowedCategories     Json        @default("[]")
  allowedMarketplaces   Json        @default("[]")
  minScore              Int         @default(70)
  minPrice              Decimal?    @db.Decimal(12, 2)
  maxPrice              Decimal?    @db.Decimal(12, 2)
  minDiscountPercentage Decimal?    @db.Decimal(5, 2)
  minRepeatDays         Int         @default(7)
  enabled               Boolean     @default(true)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  publications Publication[]

  @@index([type, enabled])
}

model Product {
  id                String      @id @default(cuid())
  marketplace       Marketplace
  externalProductId String
  title             String
  description       String?
  category          String?
  imageUrl          String?
  productUrl        String
  rating            Decimal?    @db.Decimal(3, 2)
  salesCount        Int?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  offers Offer[]

  @@unique([marketplace, externalProductId])
  @@index([marketplace, category])
}

model Offer {
  id                   String      @id @default(cuid())
  marketplace          Marketplace
  externalProductId    String
  productId            String?
  title                String
  description          String?
  category             String?
  imageUrl             String?
  productUrl           String
  affiliateUrl         String?
  originalPrice        Decimal     @db.Decimal(12, 2)
  currentPrice         Decimal     @db.Decimal(12, 2)
  discountPercentage   Decimal     @db.Decimal(5, 2)
  couponCode           String?
  couponExpiration     DateTime?
  commissionPercentage Decimal?    @db.Decimal(5, 2)
  rating               Decimal?    @db.Decimal(3, 2)
  salesCount           Int?
  freeShipping         Boolean     @default(false)
  stockStatus          StockStatus @default(UNKNOWN)
  score                Int?
  status               OfferStatus @default(PENDING_VALIDATION)
  statusReason         String?
  collectedAt          DateTime
  verifiedAt           DateTime?
  scheduledAt          DateTime?
  publishedAt          DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  product        Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  coupons        Coupon[]
  affiliateLinks AffiliateLink[]
  scores         OfferScore[]
  publications   Publication[]
  clicks         Click[]
  conversions    Conversion[]
  commissions    Commission[]

  @@unique([marketplace, externalProductId])
  @@index([status, score])
  @@index([marketplace, category])
  @@index([scheduledAt])
  @@index([publishedAt])
}

model Coupon {
  id             String    @id @default(cuid())
  offerId        String
  code           String
  description    String?
  discountAmount Decimal?  @db.Decimal(12, 2)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([code, expiresAt])
}

model AffiliateLink {
  id           String   @id @default(cuid())
  offerId      String
  slug         String   @unique
  destination  String
  marketplace  Marketplace
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  clicks Click[]

  @@index([offerId])
  @@index([marketplace])
}

model OfferScore {
  id                    String   @id @default(cuid())
  offerId               String
  total                 Int
  discountComponent     Int
  commissionComponent   Int
  ratingComponent       Int
  popularityComponent   Int
  freeShippingComponent Int
  couponValidityComponent Int
  noveltyComponent      Int
  weights               Json
  createdAt             DateTime @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, createdAt])
}

model Publication {
  id             String            @id @default(cuid())
  offerId        String
  channelId      String
  status         PublicationStatus @default(SCHEDULED)
  scheduledAt    DateTime
  publishedAt    DateTime?
  externalId     String?
  messagePayload Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  offer       Offer                @relation(fields: [offerId], references: [id], onDelete: Cascade)
  channel     Channel              @relation(fields: [channelId], references: [id], onDelete: Cascade)
  attempts    PublicationAttempt[]
  clicks      Click[]
  conversions Conversion[]
  commissions Commission[]

  @@index([channelId, scheduledAt])
  @@index([offerId, status])
}

model PublicationAttempt {
  id             String                   @id @default(cuid())
  publicationId  String
  status         PublicationAttemptStatus @default(PENDING)
  requestPayload Json?
  responsePayload Json?
  errorMessage   String?
  attemptedAt    DateTime                 @default(now())

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@index([publicationId, attemptedAt])
}

model Click {
  id              String   @id @default(cuid())
  offerId         String
  affiliateLinkId String?
  publicationId   String?
  channelId       String?
  marketplace     Marketplace
  userAgent       String?
  referer         String?
  createdAt       DateTime @default(now())

  offer         Offer          @relation(fields: [offerId], references: [id], onDelete: Cascade)
  affiliateLink AffiliateLink? @relation(fields: [affiliateLinkId], references: [id], onDelete: SetNull)
  publication   Publication?   @relation(fields: [publicationId], references: [id], onDelete: SetNull)

  @@index([offerId, createdAt])
  @@index([publicationId, createdAt])
  @@index([marketplace, createdAt])
}

model Conversion {
  id            String      @id @default(cuid())
  marketplace   Marketplace
  externalOrderId String?
  offerId       String?
  publicationId String?
  amount        Decimal     @db.Decimal(12, 2)
  occurredAt    DateTime
  importedAt    DateTime    @default(now())
  rawPayload     Json?

  offer       Offer?       @relation(fields: [offerId], references: [id], onDelete: SetNull)
  publication Publication? @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  commissions Commission[]

  @@index([marketplace, occurredAt])
  @@index([externalOrderId])
}

model Commission {
  id            String      @id @default(cuid())
  marketplace   Marketplace
  offerId       String?
  publicationId String?
  conversionId  String?
  amount        Decimal     @db.Decimal(12, 2)
  percentage    Decimal?    @db.Decimal(5, 2)
  status        String
  occurredAt    DateTime
  importedAt    DateTime    @default(now())

  offer       Offer?       @relation(fields: [offerId], references: [id], onDelete: SetNull)
  publication Publication? @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  conversion  Conversion?  @relation(fields: [conversionId], references: [id], onDelete: SetNull)

  @@index([marketplace, occurredAt])
  @@index([status])
}

model ImportJob {
  id                   String          @id @default(cuid())
  marketplaceAccountId String?
  marketplace          Marketplace
  status               ImportJobStatus @default(QUEUED)
  source               String
  startedAt            DateTime?
  finishedAt           DateTime?
  errorMessage         String?
  rawSummary           Json?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  marketplaceAccount MarketplaceAccount? @relation(fields: [marketplaceAccountId], references: [id], onDelete: SetNull)

  @@index([marketplace, status])
}

model AutomationRun {
  id                   String              @id @default(cuid())
  marketplaceAccountId String?
  name                 String
  status               AutomationRunStatus @default(RUNNING)
  idempotencyKey       String              @unique
  startedAt            DateTime            @default(now())
  finishedAt           DateTime?
  metrics              Json?
  errorMessage         String?

  marketplaceAccount MarketplaceAccount? @relation(fields: [marketplaceAccountId], references: [id], onDelete: SetNull)

  @@index([name, startedAt])
}

model SystemAlert {
  id          String        @id @default(cuid())
  severity    AlertSeverity
  source      String
  message     String
  metadata    Json?
  acknowledged Boolean     @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([severity, acknowledged])
  @@index([source, createdAt])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
