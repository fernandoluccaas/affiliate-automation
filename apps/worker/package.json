    "@affiliate/marketplace-discovery": "0.1.0",
    "@affiliate/publication": "0.1.0",
    "@affiliate/publisher-connectors": "0.1.0",
    "@affiliate/redis": "0.1.0",
    "@affiliate/scoring": "0.1.0",
    "@affiliate/shared": "0.1.0",
    "@affiliate/validation": "0.1.0",
    "tsx": "^4.20.3",
    "vitest": "^3.2.4"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
